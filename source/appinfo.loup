@mode(host.dual)

# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "fc";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Compare two files or sets of files and display the differences (a Loup recreation of the Windows fc command).";

# Exit statuses returned by main() (fc's ERRORLEVELs). Windows reports a
# syntax error as -1, which a Linux exit status shows as 255.
pub const EXIT_SAME: int = 0;
pub const EXIT_DIFFERENT: int = 1;
pub const EXIT_CANNOT_OPEN: int = 2;
pub const EXIT_SYNTAX: int = 255;
