@mode(host.dual)

# Top level of fc: parse the arguments, handle /? and --version, run the
# comparison and turn the outcome into fc's ERRORLEVEL.
#
# Runtime: host.dual. Compiled into the native binary build/fc by `make
# build`; `loup run source/main.loup` interprets the same code. The unit tests
# call run() directly.

from appinfo import (EXIT_SAME, EXIT_CANNOT_OPEN, EXIT_SYNTAX);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.fc import (run_fc);

# Parses argv, runs fc and returns the exit status (fc's ERRORLEVEL: 0 the
# same, 1 different, 2 a file could not be opened, -1 (255) a syntax error).
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(msg);
            return EXIT_SYNTAX;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_SAME;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_SAME;
    }

    try {
        return run_fc(opts);
    } catch (Exception as e) {
        printErr(e.message);
        return EXIT_CANNOT_OPEN;
    }
}
