@mode(host.dual)

# fc's text comparison and its resynchronisation algorithm.
#
# fc does not compute a shortest edit script the way diff does. It walks
# both files in step while the lines match. At the first mismatch it looks
# ahead, at most /LBn lines in each file (default 100), for the nearest
# place where /nnnn consecutive lines (default 2) match again: the resync
# point. Candidates are tried by their total distance from the mismatch
# (lines skipped in file 1 plus lines skipped in file 2), nearest first, and
# for equal distances with fewer lines skipped in file 1 first. Then it
# prints the block of differences:
#
#     ***** FILE1
#     last matching line before the difference (if any)
#     the differing lines of file 1
#     first line of the resync point
#     ***** FILE2
#     (the same for file 2)
#     *****
#     (blank line)
#
# and carries on from the resync point. Fewer than /nnnn matching lines are
# shown as differences. When the differences run to the end of both files,
# or one file has ended, there is no resync point: the block holds the rest
# of both files. When more than /LBn lines differ and the files go on, fc
# gives up with
# `Resync Failed.  Files are too different.` and shows what it had read.
#
# Runtime: host.dual. Compiled into the native binary build/fc by `make
# build`; `loup run source/main.loup` interprets the same code.
#
# Structure: TextFile and prepare_text; output helpers (format_line, dump);
# find_resync, the look-ahead; and compare_text, the main loop, which
# alternates a run of matching lines with one block of differences.

from cli.args import (Options);
from commands.lines import (split_lines, expand_tabs, line_key);
from commands.report import (Report, make_report, MSG_NO_DIFFERENCES);

pub const MSG_RESYNC_FAILED: string = "Resync Failed.  Files are too different.";

# One file ready for comparison.
pub struct TextFile {
    pub name: string;          # as fc prints it
    pub shown: list[string];   # the lines as printed: tabs expanded unless /T
    pub keys: list[string];    # the lines as compared: /C and /W applied
}

# Splits a file's text into lines and computes their comparison keys.
pub func prepare_text(name: string, text: string, opts: Options): TextFile {
    var shown: list[string] = [];
    var keys: list[string] = [];
    for (raw in split_lines(text)) {
        let line = if (opts.keep_tabs) { raw } else { expand_tabs(raw) };
        shown.push(line);
        keys.push(line_key(line, opts.ignore_case, opts.white));
    }
    return TextFile(name = name, shown = shown, keys = keys);
}

# Whether `count` lines match from line x of file 1 and line y of file 2.
# (The helpers below take lists and scalars, not TextFile or Options: a
# struct holding a list is copied on every call in native builds.)
func run_matches(keys1: list[string], keys2: list[string], x: int, y: int, count: int): bool {
    if (x + count > keys1.len() or y + count > keys2.len()) {
        return false;
    }
    for (k in 0..count) {
        if (keys1[x + k] != keys2[y + k]) {
            return false;
        }
    }
    return true;
}

func pad_number(n: int): string {
    var text = str(n);
    while (text.len() < 5) {
        text = " " + text;
    }
    return text;
}

# One line as fc prints it: with /N, the line number right-aligned in five
# columns, a colon and two spaces.
pub func format_line(shown: list[string], index: int, numbers: bool): string {
    if (numbers) {
        return pad_number(index + 1) + ":  " + shown[index];
    }
    return shown[index];
}

# Appends lines first..last-1 of a file. With /A, a run of more than two
# lines is shortened to its first line, `...` and its last line.
func dump(edits out: list[string], shown: list[string], first: int, last: int, abbreviate: bool,
    numbers: bool): void {
    if (abbreviate and last - first > 2) {
        out.push(format_line(shown, first, numbers));
        out.push("...");
        out.push(format_line(shown, last - 1, numbers));
        return;
    }
    for (k in first..last) {
        out.push(format_line(shown, k, numbers));
    }
}

func min_int(a: int, b: int): int {
    return if (a < b) { a } else { b };
}

func max_int(a: int, b: int): int {
    return if (a > b) { a } else { b };
}

# The resync point after a mismatch at lines i and j: [x, y], or [-1, -1].
# At most `limit` differing lines are allowed on each side.
pub func find_resync(keys1: list[string], keys2: list[string], i: int, j: int, limit: int,
    sync: int): list[int] {
    # `s` is the total distance (lines skipped in both files) and `dx` the
    # lines skipped in file 1, so candidates come nearest first and, at
    # equal distance, with fewer lines of file 1 skipped.
    let span1 = min_int(limit, keys1.len() - i);
    let span2 = min_int(limit, keys2.len() - j);
    var s = 1;
    while (s <= span1 + span2) {
        var dx = max_int(0, s - span2);
        let top = min_int(s, span1);
        while (dx <= top) {
            let x = i + dx;
            let y = j + (s - dx);
            if (run_matches(keys1, keys2, x, y, sync)) {
                return [x, y];
            }
            dx += 1;
        }
        s += 1;
    }
    return [-1, -1];
}

# Compares two prepared files and returns what fc prints for them.
pub func compare_text(f1: TextFile, f2: TextFile, opts: Options): Report {
    let shown1 = f1.shown;
    let shown2 = f2.shown;
    let keys1 = f1.keys;
    let keys2 = f2.keys;
    let header1 = "***** " + f1.name;
    let header2 = "***** " + f2.name;
    let abbreviate = opts.abbreviate;
    let numbers = opts.numbers;
    let limit = opts.buffer_lines;
    let sync = opts.sync_lines;

    var out: list[string] = [];
    var different = false;
    let n1 = keys1.len();
    let n2 = keys2.len();
    var i = 0;
    var j = 0;
    while (true) {
        while (i < n1 and j < n2 and keys1[i] == keys2[j]) {
            i += 1;
            j += 1;
        }
        if (i >= n1 and j >= n2) {
            break;
        }
        # A mismatch at lines i and j: find where the block of differences
        # ends (one of three cases below), print it, and go on from the
        # resync point.
        different = true;
        # The last matching line goes with the block, as context.
        let from1 = if (i > 0 and j > 0) { i - 1 } else { i };
        let from2 = if (i > 0 and j > 0) { j - 1 } else { j };
        var to1 = 0;
        var to2 = 0;
        var last = false;
        let found = find_resync(keys1, keys2, i, j, limit, sync);
        if (found[0] >= 0) {
            # The block ends with the first line of the resync point.
            to1 = found[0] + 1;
            to2 = found[1] + 1;
        } else if ((n1 - i <= limit and n2 - j <= limit) or i >= n1 or j >= n2) {
            # The differences run to the end of both files (or one file has
            # ended, so nothing can match again).
            to1 = n1;
            to2 = n2;
            last = true;
        } else {
            out.push(MSG_RESYNC_FAILED);
            to1 = min_int(i + limit, n1);
            to2 = min_int(j + limit, n2);
            last = true;
        }
        out.push(header1);
        dump(edits: out, shown1, from1, to1, abbreviate, numbers);
        out.push(header2);
        dump(edits: out, shown2, from2, to2, abbreviate, numbers);
        out.push("*****");
        out.push("");
        if (last) {
            break;
        }
        i = found[0];
        j = found[1];
    }
    if (!different) {
        out.push(MSG_NO_DIFFERENCES);
        out.push("");
    }
    return make_report(out, different);
}
