@mode(host.dual)

# Unit tests for fc's exit statuses over whole command lines (cli.app.run).
# These tests print the program's normal output.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with Stage0 (`loup-bootstrap test --no-parallel`, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary. The files it
# compares are created under build/tmp/ (removed by `make clean`).

from debug.assert import (expectEq);
from io.fs import (createDir, writeText, removeDir, isDir);
from appinfo import (EXIT_SAME, EXIT_DIFFERENT, EXIT_CANNOT_OPEN, EXIT_SYNTAX);
from cli.app import (run);

const ROOT: string = "build/tmp/fc_app";

func test_version_and_help(): void {
    expectEq(run(["--version"]), EXIT_SAME, "--version");
    expectEq(run(["/?"]), EXIT_SAME, "/?");
}

func test_syntax_errors(): void {
    let none: list[string] = [];
    expectEq(run(none), EXIT_SYNTAX, "no operand");
    expectEq(run(["a.txt"]), EXIT_SYNTAX, "one operand");
    expectEq(run(["a", "b", "c"]), EXIT_SYNTAX, "three operands");
    expectEq(run(["/LB0", "a", "b"]), EXIT_SYNTAX, "bad /LB");
}

func test_compare(): void {
    if (isDir(ROOT)) {
        removeDir(ROOT);
    }
    createDir(ROOT);
    writeText(ROOT + "/a.txt", "one\ntwo\n");
    writeText(ROOT + "/b.txt", "one\ntwo\n");
    writeText(ROOT + "/c.txt", "one\nTWO\n");
    expectEq(run([ROOT + "\\a.txt", ROOT + "/b.txt"]), EXIT_SAME, "same");
    expectEq(run([ROOT + "/a.txt", ROOT + "/c.txt"]), EXIT_DIFFERENT, "different");
    expectEq(run(["/C", ROOT + "/a.txt", ROOT + "/c.txt"]), EXIT_SAME, "/C");
    expectEq(run(["/B", ROOT + "/a.txt", ROOT + "/c.txt"]), EXIT_DIFFERENT, "/B");
    expectEq(run([ROOT + "/a.txt", ROOT + "/missing.txt"]), EXIT_CANNOT_OPEN, "missing");
    expectEq(run([ROOT + "/*.txt", ROOT + "/a.txt"]), EXIT_DIFFERENT, "wildcard");
    removeDir(ROOT);
}
